#!/bin/bash

# Hardened Distrobox Manager
# Secure creation: generate Distrobox OCI command, then enforce a strict Podman allowlist.
# Creates secure Distrobox instances with isolated home directories
# and comprehensive opt-in permission system

set -euo pipefail

SCRIPT_NAME="$(basename "$0")"
DISTROBOX_BASE_DIR="${HOME}/.local/share/distrobox-secure"
CONFIG_DIR="${HOME}/.config/distrobox-secure"
PERMISSIONS_FILE="${CONFIG_DIR}/permissions.conf"

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Logging function
log() {
    echo -e "${GREEN}[INFO]${NC} $*"
}

warn() {
    echo -e "${YELLOW}[WARN]${NC} $*"
}

error() {
    echo -e "${RED}[ERROR]${NC} $*" >&2
}

# Initialize directories
init_dirs() {
    mkdir -p "$DISTROBOX_BASE_DIR"
    mkdir -p "$CONFIG_DIR"
    
    if [[ ! -f "$PERMISSIONS_FILE" ]]; then
        cat > "$PERMISSIONS_FILE" << 'EOF'
# Distrobox Secure Permissions Configuration
# Format: container_name:permission_type:value
# 
# FILESYSTEM PERMISSIONS:
# home_folder:/path/to/folder     - Mount specific host directory
# mount:/src/path:/dst/path       - Mount with custom destination
# mount:/src:/dst:rw,z            - Opt-in SELinux shared relabel (changes host labels!)
# 
# NETWORK PERMISSIONS:
# network:host                    - Enable host networking
# network:bridge                  - Use bridge networking
# 
# DISPLAY PERMISSIONS (currently unsupported; secure creator rejects them):
# x11:enable                      - Enable X11 forwarding
# wayland:enable                  - Enable Wayland support
# 
# HARDWARE PERMISSIONS (currently unsupported; secure creator rejects them):
# audio:enable                    - Enable audio passthrough
# gpu:enable                      - Enable GPU access
# usb:enable                      - Enable USB device access
# webcam:enable                   - Enable webcam access
# 
# NAMESPACE ISOLATION (disable these for more access):
# unshare_netns:false            - Disable network namespace isolation
# unshare_devsys:false           - Disable /dev and /sys isolation
# unshare_groups:false           - Disable group isolation
# unshare_ipc:false              - Disable IPC isolation
# unshare_process:false          - Disable process isolation
# unshare_all:false              - Disable all namespace isolation
# 
# SECURITY PERMISSIONS:
# privileged:enable              - REJECTED by secure mode
# root:enable                    - REJECTED by secure mode
# init:enable                    - REJECTED by secure mode
# hostname:custom_name           - Set custom hostname
# 
# ADDITIONAL CAPABILITIES (currently unsupported; secure creator rejects them):
# cap_add:SYS_ADMIN              - REJECTED by secure mode
# security_opt:seccomp=unconfined - REJECTED by secure mode
# 
# Examples:
# mycontainer:home_folder:/home/user/Documents
# mycontainer:network:host
# mycontainer:audio:enable
# mycontainer:unshare_netns:false
# mycontainer:mount:/media/external:/mnt/external

EOF
        log "Created permissions config at $PERMISSIONS_FILE"
    fi
}

# Check dependencies
check_deps() {
    local deps=("distrobox" "podman" "python3")
    for dep in "${deps[@]}"; do
        if ! command -v "$dep" &> /dev/null; then
            error "$dep is not installed"
            exit 1
        fi
    done
}

# Validate container name
validate_container_name() {
    local name="$1"
    if [[ ! "$name" =~ ^[a-zA-Z0-9._-]+$ ]]; then
        error "Invalid container name: '$name'. Must contain only alphanumeric characters, dots, hyphens, and underscores."
        return 1
    fi
    return 0
}

# Validate filesystem path exists
validate_path() {
    local path="$1"
    if [[ ! -e "$path" ]] && [[ ! -d "$path" ]]; then
        warn "Path does not exist: $path (this will be created on mount)"
        return 0
    fi
    if [[ ! -r "$path" ]]; then
        error "Path is not readable: $path"
        return 1
    fi
    return 0
}

# Parse mount permissions as <src>:<dst>.
#
# Split on the last colon so host paths may still contain colons. Container
# destination paths containing colons are not supported.
parse_mount_permission() {
    local mount_value="$1"
    local src_path dst_path

    if [[ "$mount_value" != *:* ]]; then
        error "Invalid mount value: '$mount_value'. Expected format: <src>:<dst>"
        return 1
    fi

    src_path="${mount_value%:*}"
    dst_path="${mount_value##*:}"

    if [[ -z "$src_path" ]] || [[ -z "$dst_path" ]]; then
        error "Invalid mount value: '$mount_value'. Expected format: <src>:<dst>"
        return 1
    fi

    printf '%s\n%s\n' "$src_path" "$dst_path"
}

# Create isolated home directory for container
create_isolated_home() {
    local container_name="$1"
    local isolated_home="${DISTROBOX_BASE_DIR}/${container_name}-home"
    
    if [[ ! -d "$isolated_home" ]]; then
        mkdir -p "$isolated_home"
        
        # Create basic structure
        mkdir -p "$isolated_home"/{Desktop,Documents,Downloads,Pictures,Videos,Music}
        
        # Create minimal shell config
        cat > "$isolated_home/.bashrc" << 'EOF'
# Isolated Distrobox environment
export PS1='\[\033[01;31m\][DISTROBOX-SECURE]\[\033[00m\] \[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ '
echo "Welcome to your secure isolated Distrobox environment!"
echo "Run 'distrobox-secure --help' for permission management."
echo "Current isolation status:"
echo "  - Isolated home directory: $(pwd)"
echo "  - Network: $(ip route 2>/dev/null | grep -q default && echo 'Connected' || echo 'Isolated')"
echo "  - Process namespace: $(ps aux | wc -l) processes visible"
EOF
        
        log "Created isolated home directory: $isolated_home" >&2
    fi
    
    echo "$isolated_home"
}

# Get permissions for container
get_permissions() {
    local container_name="$1"
    local permissions=()
    local unshare_flags=()
    
    # Default security settings (can be overridden by permissions)
    local unshare_netns=true
    local unshare_devsys=true
    local unshare_groups=true
    local unshare_ipc=true
    local unshare_process=true
    local unshare_all=false
    
    # Read permissions from config file
    if [[ -f "$PERMISSIONS_FILE" ]]; then
        while IFS=':' read -r name perm_type perm_value; do
            # Skip comments and empty lines
            [[ "$name" =~ ^[[:space:]]*# ]] && continue
            [[ -z "$name" ]] && continue
            
            if [[ "$name" == "$container_name" ]]; then
                case "$perm_type" in
                    # Filesystem permissions
                    "home_folder")
                        permissions+=("--volume" "${perm_value}:${perm_value}:rw")
                        ;;
                    "mount")
                        local src_path dst_path
                        readarray -t mount_parts < <(parse_mount_permission "$perm_value") || return 1
                        src_path="${mount_parts[0]}"
                        dst_path="${mount_parts[1]}"
                        permissions+=("--volume" "${src_path}:${dst_path}:rw")
                        ;;
                    
                    # Network permissions
                    "network")
                        case "$perm_value" in
                            "host")
                                permissions+=("--additional-flags" "--network=host")
                                unshare_netns=false
                                ;;
                            "bridge")
                                permissions+=("--additional-flags" "--network=bridge")
                                unshare_netns=false
                                ;;
                        esac
                        ;;
                    
                    # Display permissions
                    "x11")
                        if [[ "$perm_value" == "enable" ]]; then
                            permissions+=("--volume" "/tmp/.X11-unix:/tmp/.X11-unix:rw")
                            permissions+=("--env" "DISPLAY=${DISPLAY}")
                            permissions+=("--env" "XAUTHORITY=${XAUTHORITY:-}")
                        fi
                        ;;
                    "wayland")
                        if [[ "$perm_value" == "enable" ]]; then
                            permissions+=("--volume" "${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY:-wayland-0}:${XDG_RUNTIME_DIR}/${WAYLAND_DISPLAY:-wayland-0}:rw")
                            permissions+=("--env" "WAYLAND_DISPLAY=${WAYLAND_DISPLAY:-wayland-0}")
                        fi
                        ;;
                    
                    # Hardware permissions
                    "audio")
                        if [[ "$perm_value" == "enable" ]]; then
                            permissions+=("--volume" "/run/user/$(id -u)/pulse:/run/user/$(id -u)/pulse:rw")
                            permissions+=("--volume" "/dev/snd:/dev/snd:rw")
                        fi
                        ;;
                    "gpu")
                        if [[ "$perm_value" == "enable" ]]; then
                            permissions+=("--device" "/dev/dri")
                            [[ -e /dev/nvidia0 ]] && permissions+=("--device" "/dev/nvidia0")
                            [[ -e /dev/nvidiactl ]] && permissions+=("--device" "/dev/nvidiactl")
                            [[ -e /dev/nvidia-uvm ]] && permissions+=("--device" "/dev/nvidia-uvm")
                        fi
                        ;;
                    "usb")
                        if [[ "$perm_value" == "enable" ]]; then
                            permissions+=("--volume" "/dev/bus/usb:/dev/bus/usb:rw")
                            unshare_devsys=false
                        fi
                        ;;
                    "webcam")
                        if [[ "$perm_value" == "enable" ]]; then
                            permissions+=("--device" "/dev/video0")
                        fi
                        ;;
                    
                    # Namespace isolation controls
                    "unshare_netns")
                        [[ "$perm_value" == "false" ]] && unshare_netns=false
                        ;;
                    "unshare_devsys")
                        [[ "$perm_value" == "false" ]] && unshare_devsys=false
                        ;;
                    "unshare_groups")
                        [[ "$perm_value" == "false" ]] && unshare_groups=false
                        ;;
                    "unshare_ipc")
                        [[ "$perm_value" == "false" ]] && unshare_ipc=false
                        ;;
                    "unshare_process")
                        [[ "$perm_value" == "false" ]] && unshare_process=false
                        ;;
                    "unshare_all")
                        if [[ "$perm_value" == "false" ]]; then
                            unshare_all=false
                            unshare_netns=false
                            unshare_devsys=false
                            unshare_groups=false
                            unshare_ipc=false
                            unshare_process=false
                        elif [[ "$perm_value" == "true" ]]; then
                            unshare_all=true
                        fi
                        ;;
                    
                    # Security permissions
                    "privileged")
                        if [[ "$perm_value" == "enable" ]]; then
                            permissions+=("--privileged")
                        fi
                        ;;
                    "root")
                        if [[ "$perm_value" == "enable" ]]; then
                            permissions+=("--root")
                        fi
                        ;;
                    "init")
                        if [[ "$perm_value" == "enable" ]]; then
                            permissions+=("--init")
                        fi
                        ;;
                    "hostname")
                        permissions+=("--hostname" "$perm_value")
                        ;;
                    
                    # Additional capabilities
                    "cap_add")
                        permissions+=("--cap-add" "$perm_value")
                        ;;
                    "security_opt")
                        permissions+=("--security-opt" "$perm_value")
                        ;;
                esac
            fi
        done < "$PERMISSIONS_FILE"
    fi
    
    # Apply unshare flags based on final state
    [[ "$unshare_netns" == true ]] && unshare_flags+=("--unshare-netns")
    [[ "$unshare_devsys" == true ]] && unshare_flags+=("--unshare-devsys")
    [[ "$unshare_groups" == true ]] && unshare_flags+=("--unshare-groups")
    [[ "$unshare_ipc" == true ]] && unshare_flags+=("--unshare-ipc")
    [[ "$unshare_process" == true ]] && unshare_flags+=("--unshare-process")
    [[ "$unshare_all" == true ]] && unshare_flags+=("--unshare-all")
    
    # Output all flags
    printf '%s\n' "${unshare_flags[@]}" "${permissions[@]}"
}

# Strict Distrobox-compatible creator. We use upstream Distrobox --dry-run to obtain
# its entrypoint and init arguments, but NEVER execute its generated Podman command.
# In particular, upstream sets --privileged, label=disable and broad host mounts.
# The Python allowlist instead constructs a new rootless podman create command.
# A future incompatible Distrobox CLI fails closed rather than falling back.
secure_distrobox_create() {
    local container_name="$1" image="$2" isolated_home="$3" action="${4:-create}"
    python3 - "$container_name" "$image" "$isolated_home" "$PERMISSIONS_FILE" \
        "$DISTROBOX_BASE_DIR" "$action" <<'SECURE_PY'
import os
import pathlib
import re
import shlex
import shutil
import subprocess
import sys

name, image, isolated, conf, base, action = sys.argv[1:]
home = pathlib.Path.home().resolve()
isolated_path = pathlib.Path(isolated).resolve()


def fail(message):
    print(f"[ERROR] secure create: {message}", file=sys.stderr)
    raise SystemExit(1)


def within(path, parent):
    return path == parent or parent in path.parents


if os.geteuid() == 0:
    fail("rootful execution is not supported; use rootless Podman")
if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
    fail("invalid container name")
if not re.fullmatch(r"[A-Za-z0-9_./:@-]+", image):
    fail("invalid container image reference")
if not isolated_path.is_dir() or not within(isolated_path, home):
    fail("isolated home must be an existing directory below the host HOME")
if action not in ("create", "check"):
    fail("invalid action")

# Explicit filesystem grants. No automatic /, $HOME, /run/host or runtime socket mounts.
mounts = []
network = "none"
for lineno, raw in enumerate(pathlib.Path(conf).read_text().splitlines(), 1):
    line = raw.strip()
    if not line or line.startswith("#"):
        continue
    parts = line.split(":", 2)
    if len(parts) != 3 or parts[0] != name:
        continue
    _, kind, value = parts
    if kind == "network":
        if value not in ("host", "bridge"):
            fail(f"line {lineno}: unsupported network grant {value!r}")
        network = value
        continue
    if kind.startswith("unshare_"):
        if value != "true":
            fail(f"line {lineno}: disabling namespace isolation is not supported in secure mode")
        continue
    if kind not in ("mount", "home_folder"):
        fail(f"line {lineno}: grant {kind!r} is not supported in secure mode; refusing unsafe fallback")

    mode = "rw"
    if kind == "home_folder":
        source, target = value, value
    else:
        # Existing syntax: mount:<source>:<target>
        # Optional explicit SELinux shared relabel: mount:<source>:<target>:rw,z
        v = value.rsplit(":", 1)
        if len(v) == 2 and v[1] in ("ro", "rw", "ro,z", "rw,z"):
            value, mode = v
        if ":" not in value:
            fail(f"line {lineno}: expected mount:<source>:<target>[:ro|rw|ro,z|rw,z]")
        source, target = value.rsplit(":", 1)

    if not source.startswith("/") or not target.startswith("/") or "\x00" in source + target:
        fail(f"line {lineno}: source and destination must be absolute")
    src_path = pathlib.Path(source).resolve()
    target_path = pathlib.PurePosixPath(os.path.normpath(target))
    if not src_path.exists():
        fail(f"line {lineno}: source does not exist: {source}")
    if src_path == pathlib.Path("/") or src_path == home or within(home, src_path):
        fail(f"line {lineno}: broad host mount forbidden: {source}")
    if within(src_path, isolated_path):
        fail(f"line {lineno}: do not expose managed isolated-home contents as a new grant")
    if any(str(target_path) == p or str(target_path).startswith(p + "/") for p in
           ("/run/host", "/run/user", "/proc", "/sys", "/dev")):
        fail(f"line {lineno}: forbidden container destination: {target}")
    if str(target_path) == str(isolated_path) or str(target_path) == str(home):
        fail(f"line {lineno}: destination would replace container home: {target}")
    # No mount may replace an ancestor of the isolated home: it would shadow mounts.
    if within(isolated_path, pathlib.Path(str(target_path))):
        fail(f"line {lineno}: destination overlaps a parent of isolated home")
    if target_path in [pathlib.PurePosixPath("/usr"), pathlib.PurePosixPath("/etc")]:
        fail(f"line {lineno}: forbidden broad container destination")
    mounts.append((str(src_path), str(target_path), mode))

# Reject overlapping target mounts: last-wins would silently mask an earlier grant.
targets = [pathlib.PurePosixPath(m[1]) for m in mounts]
for i, a in enumerate(targets):
    for b in targets[i + 1:]:
        if a == b or a in b.parents or b in a.parents:
            fail(f"overlapping mount destinations: {a} and {b}")

# Distrobox generates its current init invocation and associated metadata.
# Parsing shlex without shell evaluation is intentional; don't execute dry-run text.
cmd = ["distrobox", "create", "--dry-run", "--no-entry", "--name", name,
       "--image", image, "--home", str(isolated_path), "--unshare-netns",
       "--unshare-process", "--unshare-ipc", "--unshare-groups",
       "--unshare-devsys"]
try:
    output = subprocess.check_output(cmd, text=True, stderr=subprocess.PIPE)
except subprocess.CalledProcessError as err:
    fail(f"distrobox --dry-run failed: {err.stderr.strip()}")
try:
    words = shlex.split(output)
except ValueError as err:
    fail(f"invalid distrobox dry-run output: {err}")
if words[:2] != ["podman", "create"]:
    fail("unsupported Distrobox dry-run prefix (expected 'podman create')")
try:
    at = words.index("--entrypoint")
except ValueError:
    fail("Distrobox dry-run has no entrypoint")
if at + 2 >= len(words) or words[at + 1] != "/usr/bin/entrypoint" or words[at + 2] != image:
    fail("unexpected Distrobox entrypoint/image format")
prefix, init_args = words[2:at], words[at + 3:]
if not init_args or init_args[:1] != ["--verbose"] or "--home" not in init_args:
    fail("unsupported Distrobox init invocation")
if init_args[init_args.index("--home") + 1] != str(isolated_path):
    fail("Distrobox init HOME doesn't match isolated HOME")

# Only harvest a trusted Distrobox entrypoint script and expected metadata.
entrypoint = None
export_tool = None
labels = []
envs = {}
i = 0
while i < len(prefix):
    key = prefix[i]
    if key in ("--volume", "-v", "--label", "--env"):
        if i + 1 >= len(prefix):
            fail(f"malformed Distrobox {key} option")
        value = prefix[i + 1]
        if key in ("--volume", "-v"):
            v = value.split(":")
            if len(v) >= 3 and v[1] == "/usr/bin/entrypoint":
                entrypoint = v[0]
            elif len(v) >= 3 and v[1] == "/usr/bin/distrobox-export":
                export_tool = v[0]
        elif key == "--label" and value in ("manager=distrobox", "distrobox.unshare_groups=1"):
            labels.append(value)
        elif key == "--env" and "=" in value:
            k, v = value.split("=", 1)
            if k in ("SHELL", "HOME", "CONTAINER_ID", "container", "DISTROBOX_HOST_HOME"):
                envs[k] = v
        i += 2
        continue
    # Never inherit privileged status, host filesystem mounts, label=disable,
    # host namespaces, host devices or unbounded resource settings.
    i += 1
if not entrypoint or "manager=distrobox" not in labels:
    fail("Distrobox entrypoint or manager label missing")
if envs.get("HOME") != str(isolated_path) or envs.get("CONTAINER_ID") != name:
    fail("Distrobox HOME / CONTAINER_ID mismatch")
for tool in (entrypoint, export_tool):
    if tool and (not pathlib.Path(tool).is_file()):
        fail(f"Distrobox helper unavailable: {tool}")

# Copy integration scripts to a private managed directory. SELinux :Z must NEVER
# relabel distrobox's /usr/bin files on the host.
runtime = pathlib.Path(base) / ".runtime" / name
if action == "create":
    runtime.mkdir(parents=True, exist_ok=True, mode=0o700)
    runtime.chmod(0o700)
    for origin, dest in ((entrypoint, "distrobox-init"),
                         (export_tool, "distrobox-export")):
        if origin:
            shutil.copy2(origin, runtime / dest)
            (runtime / dest).chmod(0o755)

args = ["podman", "create", "--name", name,
        "--hostname", name, "--user", "root:root", "--userns=keep-id",
        "--network=" + network, "--ipc=private", "--pid=private",
        "--pids-limit=512", "--cap-drop=all", "--security-opt=no-new-privileges",
        "--tmpfs=/tmp:rw,nosuid,nodev,size=512m"]
# Distobox-init must initially run as container-root to create the user.
# Restrict the ambient capability set to its basic account/package setup needs.
for cap in ("CHOWN", "DAC_OVERRIDE", "FOWNER", "SETGID", "SETUID", "SETFCAP"):
    args.append("--cap-add=" + cap)
for label in labels:
    args += ["--label", label]
for k, v in envs.items():
    args += ["--env", f"{k}={v}"]
args += ["--env", f"XDG_CONFIG_HOME={isolated_path}/.config",
         "--env", f"XDG_DATA_HOME={isolated_path}/.local/share",
         "--env", f"XDG_CACHE_HOME={isolated_path}/.cache",
         "--env", f"XDG_STATE_HOME={isolated_path}/.local/state"]
# The isolated home belongs to distrobox-secure; only this managed source may be
# relabeled automatically. Explicit user grants are NOT relabeled by default.
args += ["--volume", f"{isolated_path}:{isolated_path}:rw,Z"]
args += ["--volume", f"{runtime / 'distrobox-init'}:/usr/bin/entrypoint:ro,Z"]
if export_tool:
    args += ["--volume", f"{runtime / 'distrobox-export'}:/usr/bin/distrobox-export:ro,Z"]
# Marker for distrobox-init's rootless mode detection.
args += ["--volume", "/dev/null:/run/.distrobox.rootless:ro"]
for src, target, mode in mounts:
    args += ["--volume", f"{src}:{target}:{mode}"]
args += ["--entrypoint", "/usr/bin/entrypoint", image] + init_args

if action == "check":
    print("[OK] secure Podman command generated and validated (not executed)")
    print("  image:", image)
    print("  network:", network)
    print("  mounts:")
    print("    managed isolated home (rw,Z):", isolated_path)
    for src, dst, mode in mounts:
        print(f"    {src} -> {dst} ({mode})")
    print("  No --privileged, no host rootfs/home, no host runtime directory")
    raise SystemExit(0)
if subprocess.call(["podman", "image", "exists", image]) != 0:
    fail(f"image not available locally: {image}; build/pull it first")
try:
    subprocess.run(args, check=True)
except subprocess.CalledProcessError as err:
    fail(f"podman create failed (exit {err.returncode})")

# Audit the realized OCI config. Stop and remove any unexpected container.
inspect = subprocess.check_output(["podman", "inspect", name,
    "--format", "{{json .}}"], text=True)
import json
info = json.loads(inspect)
mounts_real = info.get("Mounts") or []
expected = {(str(isolated_path), str(isolated_path)),
            (str(runtime / "distrobox-init"), "/usr/bin/entrypoint"),
            ("/dev/null", "/run/.distrobox.rootless")}
if export_tool:
    expected.add((str(runtime / "distrobox-export"), "/usr/bin/distrobox-export"))
expected |= {(src, dst) for src, dst, _ in mounts}
real = {(str(pathlib.Path(m.get("Source", "")).resolve()), m.get("Destination"))
        for m in mounts_real if m.get("Type") == "bind"}
expected = {(str(pathlib.Path(src).resolve()), dst) for src, dst in expected}
# A Podman-created tmpfs or runtime-internal anonymous volume is not a host bind.
config = info.get("HostConfig") or {}
caps_dropped = [str(v).upper() for v in (config.get("CapDrop") or [])]
unsafe = (config.get("Privileged") or
          any(str(x).startswith("label=disable") for x in (config.get("SecurityOpt") or [])) or
          not any(str(x).startswith("no-new-privileges") for x in (config.get("SecurityOpt") or [])) or
          "ALL" not in caps_dropped or
          any(dst == "/run/host" or dst.startswith("/run/host/") for _, dst in real) or
          any(src == "/" for src, _ in real) or
          any(src == str(home) and dst == str(home) for src, dst in real) or
          any(dst == "/run/user" or dst.startswith("/run/user/") for _, dst in real) or
          real != expected)
# On an enforcing SELinux host a secure sandbox must retain its process label.
selinux_enforce = pathlib.Path("/sys/fs/selinux/enforce")
if selinux_enforce.is_file() and selinux_enforce.read_text().strip() == "1":
    unsafe = unsafe or not info.get("ProcessLabel")
if unsafe:
    subprocess.run(["podman", "rm", "--force", name], check=False)
    fail(f"unsafe realized Podman configuration; removed container. missing={expected - real}, extra={real - expected}, capdrop={caps_dropped}")
print("[OK] Secure OCI audit passed. Run distrobox enter to test init.")
SECURE_PY
}

# Create hardened container
create_container() {
    local container_name="$1"
    local image="${2:-docker.io/library/ubuntu:22.04}"

    # Validate container name
    if ! validate_container_name "$container_name"; then
        exit 1
    fi

    log "Creating hardened container: $container_name"
    log "Using image: $image"

    # Create isolated home
    local isolated_home
    isolated_home=$(create_isolated_home "$container_name")

    # The Distrobox --dry-run is parsed into an allowlisted Podman create invocation.
    # The upstream arguments are deliberately NOT executed as generated.

    # Create the container
    if secure_distrobox_create "$container_name" "$image" "$isolated_home" create; then
        log "Container '$container_name' created successfully"
        log "Isolated home: $isolated_home"

        # Store image metadata for later recreation
        local metadata_dir="${DISTROBOX_BASE_DIR}/.metadata"
        mkdir -p "$metadata_dir"
        echo "$image" > "${metadata_dir}/${container_name}.image"

        log "Secure creation validated; host grants were verified individually"

        log "To enter the container: distrobox enter $container_name"
    else
        error "Failed to create container '$container_name'"
        exit 1
    fi
}

# Grant permission to existing container
grant_permission() {
    local container_name="$1"
    local perm_type="$2"
    local perm_value="$3"

    # Validate container name
    if ! validate_container_name "$container_name"; then
        exit 1
    fi

    # Validate permission type
    local valid_perms=(
        "home_folder" "mount" "network" "x11" "wayland" "audio" "gpu" "usb" "webcam"
        "unshare_netns" "unshare_devsys" "unshare_groups" "unshare_ipc" "unshare_process" "unshare_all"
        "privileged" "root" "init" "hostname" "cap_add" "security_opt"
    )

    if [[ ! " ${valid_perms[*]} " =~ " ${perm_type} " ]]; then
        error "Invalid permission type: $perm_type"
        echo "Valid types: ${valid_perms[*]}"
        exit 1
    fi

    # Reject options not supported by the strict container creator.
    # Do not record a permission that would fail the next recreation.
    case "$perm_type" in
        "mount"|"home_folder"|"network") ;;
        *) error "Permission '$perm_type' is not supported in secure mode"; return 1 ;;
    esac

    # Validate path-based permissions
    case "$perm_type" in
        "home_folder"|"mount")
            if [[ "$perm_type" == "mount" ]]; then
                local src_path
                # A final :rw,z/:ro,z is an explicit SELinux opt-in.
                local spec="$perm_value"
                case "$spec" in
                    *:ro|*:rw|*:ro,z|*:rw,z) spec="${spec%:*}" ;;
                esac
                [[ "$spec" == *:* ]] || { error "Invalid mount: $perm_value"; return 1; }
                src_path="${spec%:*}"
                validate_path "$src_path" || exit 1
            else
                validate_path "$perm_value" || exit 1
            fi
            ;;
    esac

    # Add permission to config file
    echo "${container_name}:${perm_type}:${perm_value}" >> "$PERMISSIONS_FILE"
    log "Permission granted: $container_name -> $perm_type:$perm_value"
    warn "You need to recreate the container for changes to take effect:"
    echo "  $SCRIPT_NAME recreate $container_name"
}

# Revoke permission
revoke_permission() {
    local container_name="$1"
    local perm_type="$2"
    
    # Remove permission from config file
    local temp_file
    temp_file=$(mktemp)
    grep -v "^${container_name}:${perm_type}:" "$PERMISSIONS_FILE" > "$temp_file" || true
    mv "$temp_file" "$PERMISSIONS_FILE"
    log "Permission revoked: $container_name -> $perm_type"
    warn "You need to recreate the container for changes to take effect"
}

# List permissions
list_permissions() {
    local container_name="$1"

    log "Permissions for container '$container_name':"
    if [[ -f "$PERMISSIONS_FILE" ]]; then
        local found=false
        while IFS=':' read -r name perm_type perm_value; do
            if [[ "$name" == "$container_name" ]]; then
                echo "  $perm_type: $perm_value"
                found=true
            fi
        done < "$PERMISSIONS_FILE"
        if [[ "$found" == false ]]; then
            echo "  No custom permissions configured (maximum security isolation)"
        fi
    else
        echo "  No permissions configured (maximum security isolation)"
    fi
}

# Recreate container with current permissions
recreate_container() {
    local container_name="$1"

    log "Recreating container '$container_name' with current permissions"

    # Stop and remove an existing container.
    # Do not parse distrobox list output; use the container runtime directly
    # to determine whether the container actually exists.
    if podman container exists "$container_name"; then
        distrobox stop "$container_name" 2>/dev/null || true
        distrobox rm --force "$container_name" 2>/dev/null || true

        # Safety fallback if distrobox failed to remove the underlying container.
        if podman container exists "$container_name"; then
            podman rm --force "$container_name"
        fi

        # Never continue into create while an old container still exists.
        if podman container exists "$container_name"; then
            error "Failed to remove existing container '$container_name'"
            exit 1
        fi
    fi

    # Get image from metadata or use default
    local metadata_file="${DISTROBOX_BASE_DIR}/.metadata/${container_name}.image"
    local image="docker.io/library/ubuntu:22.04"
    if [[ -f "$metadata_file" ]]; then
        image=$(cat "$metadata_file")
    fi
    create_container "$container_name" "$image"
}

# Show usage
show_usage() {
    cat << EOF
Usage: $SCRIPT_NAME <command> [options]

Commands:
  create <name> [image]     Create a new hardened container
  grant <name> <type> <val> Grant permission to container
  revoke <name> <type>      Revoke permission from container
  list <name>               List permissions for container
  recreate <name>           Recreate container with current permissions
  edit                      Edit permissions file directly
  help                      Show this help message

Permission Types:

FILESYSTEM:
  home_folder <path>        Mount host directory (e.g., /home/user/Documents)
  mount <src>:<dst>         Mount host path to container path

NETWORK:
  network host              Enable host networking
  network bridge            Enable bridge networking

DISPLAY:
  x11 enable                Enable X11 forwarding
  wayland enable            Enable Wayland support

HARDWARE:
  audio enable              Enable audio passthrough
  gpu enable                Enable GPU access
  usb enable                Enable USB device access
  webcam enable             Enable webcam access

NAMESPACE ISOLATION (set to false to disable isolation):
  unshare_netns false       Disable network namespace isolation
  unshare_devsys false      Disable /dev and /sys isolation
  unshare_groups false      Disable group isolation
  unshare_ipc false         Disable IPC isolation
  unshare_process false     Disable process isolation
  unshare_all false         Disable all namespace isolation

SECURITY (USE WITH CAUTION):
  privileged enable         Run in privileged mode
  root enable               Allow root access
  init enable               Enable init system
  hostname <name>           Set custom hostname
  cap_add <capability>      Add specific capabilities
  security_opt <option>    Modify security options

Examples:
  $SCRIPT_NAME create mydev
  $SCRIPT_NAME create mydev docker.io/library/fedora:39
  $SCRIPT_NAME grant mydev home_folder /home/user/Projects
  $SCRIPT_NAME grant mydev audio enable
  $SCRIPT_NAME grant mydev unshare_netns false
  $SCRIPT_NAME grant mydev mount /media/usb:/mnt/usb
  $SCRIPT_NAME recreate mydev
  $SCRIPT_NAME list mydev

Default Image: docker.io/library/ubuntu:22.04

Security Note:
  Containers are created with maximum isolation by default.
  All access must be explicitly granted through the permission system.
  Default isolation includes: network, device/sys, groups, IPC, and process namespaces.

EOF
}

# Main function
main() {
    check_deps
    init_dirs

    case "${1:-help}" in
        "create")
            if [[ $# -lt 2 ]]; then
                error "Container name required"
                show_usage
                exit 1
            fi
            create_container "$2" "${3:-}"
            ;;
        "grant")
            if [[ $# -lt 4 ]]; then
                error "Usage: grant <container> <permission_type> <value>"
                exit 1
            fi
            grant_permission "$2" "$3" "$4"
            ;;
        "revoke")
            if [[ $# -lt 3 ]]; then
                error "Usage: revoke <container> <permission_type>"
                exit 1
            fi
            revoke_permission "$2" "$3"
            ;;
        "list")
            if [[ $# -lt 2 ]]; then
                error "Container name required"
                exit 1
            fi
            list_permissions "$2"
            ;;
        "recreate")
            if [[ $# -lt 2 ]]; then
                error "Container name required"
                exit 1
            fi
            recreate_container "$2"
            ;;
        "edit")
            "${EDITOR:-nano}" "$PERMISSIONS_FILE"
            ;;
        "help"|"--help"|"-h")
            show_usage
            ;;
        *)
            error "Unknown command: $1"
            show_usage
            exit 1
            ;;
    esac
}

# Only run main if not being sourced for testing
if [[ "${DISTROBOX_SECURE_TEST:-0}" != "1" ]]; then
    main "$@"
fi
